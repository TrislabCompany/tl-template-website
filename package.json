{
  "name": "tl-template-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "pnpm run check:template && astro check && pnpm run lint && pnpm run test:unit && astro build && pnpm run check:built",
    "check:built": "node scripts/check-page-weight.mjs && node scripts/check-security-txt.mjs && node scripts/check-sitemap.mjs && node scripts/check-claims.mjs && node scripts/check-browser.mjs",
    "check:template": "node scripts/check-template-manifest.mjs",
    "lint": "eslint .",
    "test:unit": "node --test \"scripts/*.test.mjs\"",
    "test:a11y": "node scripts/quality.mjs a11y",
    "co2": "node scripts/co2-estimate.mjs",
    "status": "node scripts/status.mjs",
    "init-site": "node scripts/init-site.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.3.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@tgwf/co2": "0.19.0",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "pa11y-ci": "5.0.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "puppeteer",
      "sharp",
      "workerd"
    ]
  }
}
