{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test:a11y)",
      "Bash(pnpm status)"
    ],
    "ask": [
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)",
      "Edit(/.github/actions/**)",
      "Write(/.github/actions/**)"
    ],
    "deny": [
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler pages deploy*)",
      "Bash(*wrangler pages publish*)",
      "Bash(git tag -a*)",
      "Bash(git tag -s*)",
      "Bash(git tag -f*)",
      "Bash(git tag -d*)",
      "Bash(git tag --annotate*)",
      "Bash(git tag --sign*)",
      "Bash(git tag --force*)",
      "Bash(git tag --delete*)",
      "Bash(git push * --tags*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
