---
import ContactDetails from "../../components/ContactDetails.astro";
import { languagePaths, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
---

<BaseLayout title={t(lang, "contact.title")} lang={lang}>
  <h1>{t(lang, "contact.title")}</h1>
  <ContactDetails lang={lang} />
</BaseLayout>
