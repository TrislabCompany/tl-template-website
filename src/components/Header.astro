---
import { localizedPath, t, type Lang } from "../i18n";
import site from "../site.config";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  lang: Lang;
  path: string;
  available?: readonly Lang[];
}

const { lang, path, available } = Astro.props;
const links = [
  { href: "/", label: t(lang, "nav.home") },
  { href: "/about", label: t(lang, "nav.about") },
  { href: "/contact", label: t(lang, "nav.contact") },
];
---

<header class="site-header">
  <a class="brand" href={localizedPath(lang)}>{site.name}</a>
  <nav aria-label={t(lang, "nav.main")}>
    {
      links.map(({ href, label }) => (
        <a href={localizedPath(lang, href)} aria-current={path === href ? "page" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
  <LanguageSwitch lang={lang} path={path} available={available} />
</header>
