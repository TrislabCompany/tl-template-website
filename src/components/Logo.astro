---
// The site's logo mark: a neutral sample, replace it with the brand's. One of
// the two brand files with public/favicon.svg. Decorative: the name next to it
// carries the meaning, so it is hidden from assistive technology.
interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="6" fill="#2457c5"></rect>
  <path d="M8 10h16v3h-6.5v11h-3V13H8z" fill="#ffffff"></path>
</svg>
