---
import type { CollectionEntry } from "astro:content";
import { locale, localizedPath, type Lang } from "../i18n";
import { articleSlug } from "../lib/content";

interface Props {
  article: CollectionEntry<"articles">;
  lang: Lang;
}

const { article, lang } = Astro.props;
---

<article class="card">
  <h3><a href={localizedPath(lang, `/articles/${articleSlug(article)}`)}>{article.data.title}</a></h3>
  <p>{article.data.description}</p>
  <time datetime={article.data.published.toISOString()}>
    {article.data.published.toLocaleDateString(locale(lang), { dateStyle: "long" })}
  </time>
</article>
