---
import { localizedPath, t, type Lang } from "../i18n";
import site from "../site.config";
import EnvironmentBadge from "./EnvironmentBadge.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const legal = [
  { on: site.legalPages.imprint, href: "/imprint", label: t(lang, "legal.imprint") },
  { on: site.legalPages.privacy, href: "/privacy", label: t(lang, "legal.privacy") },
  { on: site.legalPages.accessibility, href: "/accessibility", label: t(lang, "legal.accessibility") },
].filter((link) => link.on);
---

<footer class="site-footer">
  <span>{t(lang, "footer.builtFrom")}</span>
  {
    legal.length > 0 && (
      <nav class="legal-links" aria-label={t(lang, "legal.nav")}>
        {legal.map(({ href, label }) => (
          <a href={localizedPath(lang, href)}>{label}</a>
        ))}
      </nav>
    )
  }
  <EnvironmentBadge />
</footer>
