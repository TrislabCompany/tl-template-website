---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StructuredData from "../components/StructuredData.astro";
import { defaultLanguage, languages, localizedPath, unlocalizedPath, type Lang } from "../i18n";
import site from "../site.config";

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** The languages this page exists in; by default all of them. */
  available?: readonly Lang[];
  /** Leave the page out of search engines (the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description[Astro.props.lang], lang, available = languages, noindex } = Astro.props;

// The page without its language prefix, for the alternates and the switch.
const path = unlocalizedPath(Astro.url.pathname);
const absolute = (target: Lang) => new URL(localizedPath(target, path), site.url).toString();
const alternates = available.length > 1 ? available : [];
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    {!noindex && <link rel="canonical" href={absolute(lang)} />}
    {!noindex && alternates.map((other) => <link rel="alternate" hreflang={other} href={absolute(other)} />)}
    {
      !noindex && alternates.includes(defaultLanguage) && (
        <link rel="alternate" hreflang="x-default" href={absolute(defaultLanguage)} />
      )
    }
    <StructuredData />
  </head>
  <body>
    <Header lang={lang} path={path} available={available} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  :root {
    --text: #1d2330;
    --muted: #5b6475;
    --accent: #2457c5;
    --surface: #ffffff;
    --background: #f5f6f8;
    --border: #dde1e8;
    color-scheme: light dark;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text: #e6e9ef;
      --muted: #a3abba;
      --accent: #7ea4ff;
      --surface: #1b1f27;
      --background: #12151b;
      --border: #2c323d;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--text);
    background: var(--background);
  }

  a {
    color: var(--accent);
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .site-header,
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: var(--surface);
  }

  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .site-header nav,
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .language-switch [aria-current] {
    font-weight: 600;
  }

  .site-header a {
    text-decoration: none;
  }

  .site-header a[aria-current="page"] {
    font-weight: 600;
    text-decoration: underline;
  }

  .site-header .brand {
    font-weight: 700;
    color: var(--text);
  }

  .card {
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .card h3 {
    margin: 0 0 0.25rem;
  }

  .card p {
    margin: 0 0 0.5rem;
  }

  time {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
