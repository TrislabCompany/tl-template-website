---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StructuredData from "../components/StructuredData.astro";
import { defaultLanguage, languages, localizedPath, ogLocale, t, unlocalizedPath, type Lang } from "../i18n";
import site from "../site.config";
import "../styles/tokens.css";
import "../styles/global.css";
// The Latin subset of the font in src/styles/tokens.css, loaded early so text is drawn once, in it.
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** The languages this page exists in; by default all of them. */
  available?: readonly Lang[];
  /** Leave the page out of search engines (the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description[Astro.props.lang], lang, available = languages, noindex } = Astro.props;

// The page without its language prefix, for the alternates and the switch.
const path = unlocalizedPath(Astro.url.pathname);
const absolute = (target: Lang) => new URL(localizedPath(target, path), site.url).toString();
const alternates = available.length > 1 ? available : [];
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    {!noindex && <link rel="canonical" href={absolute(lang)} />}
    {!noindex && alternates.map((other) => <link rel="alternate" hreflang={other} href={absolute(other)} />)}
    {
      !noindex && alternates.includes(defaultLanguage) && (
        <link rel="alternate" hreflang="x-default" href={absolute(defaultLanguage)} />
      )
    }
    <meta name="theme-color" content={site.themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(lang)} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {alternates.filter((other) => other !== lang).map((other) => <meta property="og:locale:alternate" content={ogLocale(other)} />)}
    <meta name="twitter:card" content="summary" />
    <StructuredData />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, "nav.skip")}</a>
    <Header lang={lang} path={path} available={available} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
